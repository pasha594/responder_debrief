# Base path for the built app (GitHub Pages project page). Dev default is '/'.
VITE_BASE=/responder_debrief/

# The deployed Cloudflare Worker WMS proxy origin (no trailing slash).
# In dev this can stay empty: vite's dev server proxies /wms01 and /wms02 itself.
VITE_PROXY_BASE=https://responder-debrief-wms.YOURNAME.workers.dev

# Where worker-produced catalogs/tiles live (no trailing slash).
# Dev default: {BASE_URL}data (copy worker dry-run output to frontend/public/data).
# Production: the B2 bucket file URL, e.g. https://f004.backblazeb2.com/file/responder-debrief-data
VITE_DATA_BASE_URL=
